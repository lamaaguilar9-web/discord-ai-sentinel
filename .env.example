# ==============================================================================
# DISCORD AI SENTINEL - CONFIGURACIÓN DE ENTORNO
# ==============================================================================

# Token del bot de Discord (obtenido en https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=tu_token_de_discord_aqui

# OpenRouter API (Recomendado: cobra fracciones de centavo de tu saldo existente)
# Obtén tu clave en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-tu-clave-aqui
OPENROUTER_MODEL=google/gemini-3.8-flash

# Google Gemini API directo (Opcional si usas OpenRouter)
GEMINI_API_KEY=

# ID del canal privado donde llegarán las alertas y logs de moderación
MOD_LOG_CHANNEL_ID=0

# Roles protegidos separados por coma (en minúsculas)
WHITELIST_ROLES=admin,moderador,mod,core team,team,holder,vip,verified

# Días mínimos de antigüedad de la cuenta para mayor tolerancia
ACCOUNT_SAFE_AGE_DAYS=30

# Umbrales de confianza IA
THRESHOLD_LEVEL_1_ALERT=0.70
THRESHOLD_LEVEL_2_ACTION=0.85
